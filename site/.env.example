# Copy to .env.local for local testing, and add the same names in Vercel's project settings.
# Never commit real values or paste them into a chat.

# Buttondown API key (Buttondown → Settings → API). Without it the waitlist politely says it isn't open yet.
BUTTONDOWN_API_KEY=

# Your site's address once you have a domain, for social preview images (e.g. https://voicelab.app)
SITE_URL=
